+static const char *afalg_hash_name(int nid)
+{
+    switch (nid) {
+    case NID_sha1:
+        return "sha1";
+    case NID_sha224:
+        return "sha224";
+    case NID_sha256:
+        return "sha256";
+    default:
+        return NULL;
+    }
+}
+
+static int afalg_hash_send(afalg_ctx *actx, const unsigned char *data,
+                           size_t len, int flags)
+{
+    size_t done = 0;
+    ssize_t ret;
+
+    while (done < len || (len == 0 && done == 0)) {
+        ret = send(actx->sfd, data ? data + done : NULL, len - done, flags);
+        if (ret < 0 && errno == EINTR)
+            continue;
+        if (ret < 0 || (len != 0 && ret == 0))
+            return 0;
+        done += (size_t)ret;
+        if (len == 0)
+            break;
+    }
+    return 1;
+}
+
+static int afalg_hash_finish_send(afalg_ctx *actx)
+{
+    size_t done = 0;
+    size_t chunk;
+    ssize_t ret;
+    int flags;
+
+    if (actx->hash_len == 0)
+        return afalg_hash_send(actx, NULL, 0, 0);
+
+    while (done < actx->hash_len) {
+        chunk = actx->hash_len - done;
+        if (chunk > 4096)
+            chunk = 4096;
+        flags = done + chunk < actx->hash_len ? MSG_MORE : 0;
+        do {
+            ret = send(actx->sfd, actx->hash_data + done, chunk, flags);
+        } while (ret < 0 && errno == EINTR);
+        if (ret < 0 || ret == 0 || (flags == 0 && (size_t)ret != chunk))
+            return 0;
+        done += (size_t)ret;
+    }
+    return 1;
+}
+
+static int afalg_hash_init(EVP_MD_CTX *ctx)
+{
+    afalg_ctx *actx;
+    const char *hashname;
+
+    if (ctx == NULL)
+        return 0;
+    actx = EVP_MD_CTX_md_data(ctx);
+    if (actx == NULL)
+        return 0;
+
+    memset(actx, 0, sizeof(*actx));
+    actx->sfd = -1;
+    actx->bfd = -1;
+    hashname = afalg_hash_name(EVP_MD_CTX_type(ctx));
+    if (hashname == NULL || !afalg_create_sk(actx, "hash", hashname))
+        return 0;
+
+    actx->init_done = MAGIC_INIT_NUM;
+    return 1;
+}
+
+static int afalg_hash_update(EVP_MD_CTX *ctx, const void *data, size_t count)
+{
+    afalg_ctx *actx;
+    size_t new_len;
+    size_t new_alloc;
+    unsigned char *new_data;
+
+    if (ctx == NULL || (data == NULL && count != 0))
+        return 0;
+    if (count == 0)
+        return 1;
+
+    actx = EVP_MD_CTX_md_data(ctx);
+    if (actx == NULL || actx->init_done != MAGIC_INIT_NUM)
+        return 0;
+    if (count > (size_t)-1 - actx->hash_len)
+        return 0;
+
+    new_len = actx->hash_len + count;
+    new_alloc = actx->hash_alloc;
+    if (new_alloc < new_len) {
+        new_alloc = new_alloc ? new_alloc : 256;
+        while (new_alloc < new_len) {
+            if (new_alloc > (size_t)-1 / 2) {
+                new_alloc = new_len;
+                break;
+            }
+            new_alloc *= 2;
+        }
+        new_data = OPENSSL_realloc(actx->hash_data, new_alloc);
+        if (new_data == NULL)
+            return 0;
+        actx->hash_data = new_data;
+        actx->hash_alloc = new_alloc;
+    }
+
+    memcpy(actx->hash_data + actx->hash_len, data, count);
+    actx->hash_len = new_len;
+    return 1;
+}
+
+static int afalg_hash_final(EVP_MD_CTX *ctx, unsigned char *md)
+{
+    afalg_ctx *actx;
+    size_t digest_len;
+    size_t done = 0;
+    ssize_t ret;
+
+    if (ctx == NULL || md == NULL)
+        return 0;
+    actx = EVP_MD_CTX_md_data(ctx);
+    if (actx == NULL || actx->init_done != MAGIC_INIT_NUM)
+        return 0;
+    digest_len = (size_t)EVP_MD_size(EVP_MD_CTX_md(ctx));
+    if (digest_len == 0 || digest_len > EVP_MAX_MD_SIZE)
+        return 0;
+
+    if (!afalg_hash_finish_send(actx))
+        return 0;
+    while (done < digest_len) {
+        ret = recv(actx->sfd, md + done, digest_len - done, 0);
+        if (ret < 0 && errno == EINTR)
+            continue;
+        if (ret <= 0)
+            return 0;
+        done += (size_t)ret;
+    }
+    return 1;
+}
+
+static void afalg_hash_ctx_free(afalg_ctx *actx)
+{
+    if (actx == NULL)
+        return;
+    if (actx->sfd >= 0)
+        close(actx->sfd);
+    if (actx->bfd >= 0)
+        close(actx->bfd);
+    actx->sfd = actx->bfd = -1;
+    OPENSSL_free(actx->hash_data);
+    actx->hash_data = NULL;
+    actx->hash_len = 0;
+    actx->hash_alloc = 0;
+    actx->init_done = 0;
+}
+
+static int afalg_hash_copy(EVP_MD_CTX *to, const EVP_MD_CTX *from)
+{
+    afalg_ctx *to_ctx;
+    const afalg_ctx *from_ctx;
+    const char *hashname;
+    unsigned char *saved = NULL;
+    size_t saved_len = 0;
+
+    if (to == NULL || from == NULL)
+        return 0;
+    to_ctx = EVP_MD_CTX_md_data(to);
+    from_ctx = EVP_MD_CTX_md_data(from);
+
+    /* HMAC outer context: NO_INIT skips md_data allocation  */
+    if (to_ctx == NULL && from_ctx == NULL)
+        return 1;
+
+    if (to_ctx == NULL || from_ctx == NULL ||
+        from_ctx->init_done != MAGIC_INIT_NUM)
+        return 0;
+
+    /*
+     * EVP_MD_CTX_copy_ex first raw-memcpy's from->md_data into to->md_data,
+     * so to_ctx's socket fds and hash_data pointer alias from_ctx's.  The
+     * resources still belong to `from` - we must NOT release them here or
+     * `from`'s later cleanup will double-free.  Snapshot the source bytes,
+     * then give `to` a fresh socket and an independent copy.
+     */
+    if (from_ctx->hash_len != 0) {
+        saved = OPENSSL_malloc(from_ctx->hash_len);
+        if (saved == NULL)
+            return 0;
+        memcpy(saved, from_ctx->hash_data, from_ctx->hash_len);
+        saved_len = from_ctx->hash_len;
+    }
+
+    hashname = afalg_hash_name(EVP_MD_CTX_type(from));
+    if (hashname == NULL || !afalg_create_sk(to_ctx, "hash", hashname)) {
+        OPENSSL_free(saved);
+        return 0;
+    }
+
+    to_ctx->hash_data = saved;
+    to_ctx->hash_len = saved_len;
+    to_ctx->hash_alloc = saved_len;
+    to_ctx->init_done = MAGIC_INIT_NUM;
+    return 1;
+}
+
+static int afalg_hash_cleanup(EVP_MD_CTX *ctx)
+{
+    afalg_ctx *actx;
+
+    if (ctx == NULL)
+        return 0;
+    actx = EVP_MD_CTX_md_data(ctx);
+    if (actx == NULL)
+        return 0;
+
+    afalg_hash_ctx_free(actx);
+    return 1;
+}
+
+static int afalg_hash_ctrl(EVP_MD_CTX *ctx, int cmd, int p1, void *p2)
+{
+    /* Accept any ctrl the HMAC/sign layer sends us.  The actual HMAC
+     * keying and two-stage hash copying is done through init/update/
+     * final/copy; the ctrl path is only probed. */
+    (void)ctx;
+    (void)cmd;
+    (void)p1;
+    (void)p2;
+    return 1;
+}
+
+static EVP_MD *afalg_hash_md(int nid)
+{
+    EVP_MD *md;
+    int i;
+    int pkey_nid;
+    int digest_size;
+
+    for (i = 0; i < (int)OSSL_NELEM(afalg_digest_nids); i++)
+        if (afalg_digest_nids[i] == nid)
+            break;
+    if (i == (int)OSSL_NELEM(afalg_digest_nids))
+        return NULL;
+    if (afalg_digest_handles[i] != NULL)
+        return afalg_digest_handles[i];
+
+    switch (nid) {
+    case NID_sha1:
+        pkey_nid = NID_sha1WithRSAEncryption;
+        digest_size = SHA_DIGEST_LENGTH;
+        break;
+    case NID_sha224:
+        pkey_nid = NID_sha224WithRSAEncryption;
+        digest_size = SHA224_DIGEST_LENGTH;
+        break;
+    case NID_sha256:
+        pkey_nid = NID_sha256WithRSAEncryption;
+        digest_size = SHA256_DIGEST_LENGTH;
+        break;
+    default:
+        return NULL;
+    }
+
+    md = EVP_MD_meth_new(nid, pkey_nid);
+    if (md == NULL ||
+        !EVP_MD_meth_set_result_size(md, digest_size) ||
+        !EVP_MD_meth_set_input_blocksize(md, SHA_CBLOCK) ||
+        !EVP_MD_meth_set_app_datasize(md, sizeof(afalg_ctx)) ||
+        !EVP_MD_meth_set_flags(md, EVP_MD_FLAG_DIGALGID_ABSENT) ||
+        !EVP_MD_meth_set_init(md, afalg_hash_init) ||
+        !EVP_MD_meth_set_update(md, afalg_hash_update) ||
+        !EVP_MD_meth_set_final(md, afalg_hash_final) ||
+        !EVP_MD_meth_set_copy(md, afalg_hash_copy) ||
+        !EVP_MD_meth_set_cleanup(md, afalg_hash_cleanup) ||
+        !EVP_MD_meth_set_ctrl(md, afalg_hash_ctrl)) {
+        EVP_MD_meth_free(md);
+        return NULL;
+    }
+    afalg_digest_handles[i] = md;
+    return md;
+}
+
+static int afalg_digests(ENGINE *e, const EVP_MD **digest,
+                         const int **nids, int nid)
+{
+    if (digest == NULL) {
+        *nids = afalg_digest_nids;
+        return (int)OSSL_NELEM(afalg_digest_nids);
+    }
+
+    *digest = afalg_hash_md(nid);
+    return *digest != NULL;
+}
